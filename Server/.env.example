# ==============================================================================
# SERVER (Express + MongoDB Backend) — EXAMPLE
# ==============================================================================
# Copy to .env and fill in values: cp .env.example .env

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=7001
NODE_ENV=development
# Set to "true" only once the site is served over HTTPS — browsers drop
# "secure" session cookies over plain HTTP, which silently breaks login.
COOKIE_SECURE=false

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE=mongodb://127.0.0.1:27017/nagarpalika

# ── SESSION ───────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-64-char-random-hex-string
# Set true for production HTTPS (enforces Secure cookie flag)
COOKIE_SECURE=true

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── JWT AUTHENTICATION ────────────────────────────────────────────────────────
ADMIN_JWT_SECRET_KEY=replace-with-strong-random-secret
EMPLOYEE_JWT_SECRET_KEY=replace-with-strong-random-secret
DOCTOR_JWT_SECRET_KEY=replace-with-strong-random-secret
JWT_EXPIRY=7d

# ── WHATSAPP BUSINESS API ─────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_OTP_TEMPLATE=otp_verification
WHATSAPP_WEBHOOK_VERIFY_TOKEN=nagarpalika-whatsapp-verify

# ── SMS GATEWAY (OTP fallback after WhatsApp failure) ─────────────────────────
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=NAGPAL

# ── EMAIL / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=admin@onlinejobportal.org

# ── TARGETED OTP CONFIGURATION ────────────────────────────────────────────────
# Primary channel for sending OTPs: email | sms | whatsapp
OTP_PRIMARY_CHANNEL=email
# Set true to enable automatic fallback across channels when primary fails
OTP_ENABLE_FALLBACK=false
OTP_FALLBACK_CHAIN=email,sms,whatsapp

# ── UIDAI / AADHAAR OTP API (optional — not used in current scope) ─────────────
UIDAI_AUA_CODE=
UIDAI_ASA_LICENSE_KEY=
UIDAI_API_URL=https://auth.uidai.gov.in/

# ── PAYMENT GATEWAY ───────────────────────────────────────────────────────────
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── FILE STORAGE (S3 required — no local uploads) ───────────────────────────
MAX_IMAGE_SIZE=5242880
MAX_PHOTO_SIZE=5242880
MAX_SIGNATURE_SIZE=5242880
MAX_DOCUMENT_SIZE=10485760
OTP_MAX_ATTEMPTS=3
OTP_EXPIRE_MINUTES=10
OTP_PER_HOUR_LIMIT=3
# Returns the generated OTP in response data during local development.
ENABLE_DEV_OTP=false
# ── AWS S3 (document storage) ─────────────────────────────────────────────────
# When AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY + S3_BUCKET are set, files go to S3.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=nagarpalika
# Files are served via short-lived presigned URLs by default (bucket stays private).
# Only set the two below when a genuinely PUBLIC CDN/bucket fronts the same objects;
# pointing S3_PUBLIC_BASE_URL at a private bucket produces 403s (S3_PUBLIC_CDN must be
# "true" to opt in, otherwise the value is ignored and presigning is used).
S3_PUBLIC_BASE_URL=
S3_PUBLIC_CDN=false

# ── PORTAL URLS ───────────────────────────────────────────────────────────────
PORTAL_URL=http://localhost:5173
API_URL=http://localhost:7001

# ── SECURITY (optional) ───────────────────────────────────────────────────────
ADMIN_ALLOWED_IPS=
CALL_LETTER_TOKEN_SECRET=
ENABLE_MANUAL_PAYMENT_OVERRIDE=false
